@model UniversitySystem.Domain.Entities.StudentMark

<h2>📝 Add Student Marks</h2>

<hr />

<form method="post">

    <div style="max-width:500px;">

        <label>Student</label>

        <select
            name="StudentId"
            class="form-control"
            required>

            <option value="">
                Select Student
            </option>

            @foreach(var s in ViewBag.Students)
            {
                <option value="@s.Id">
                    @s.Name
                </option>
            }

        </select>

        <br>

        <label>Course</label>

        <select
            name="CourseId"
            class="form-control"
            required>

            <option value="">
                Select Course
            </option>

            @foreach(var c in ViewBag.Courses)
            {
                <option value="@c.Id">
                    @c.Title
                </option>
            }

        </select>

        <br>

        <label>Marks</label>

        <input
            name="Marks"
            type="number"
            min="0"
            max="100"
            class="form-control"
            required
        />

        <br>

        <button
            class="btn btn-success">

            Save Marks

        </button>

        <a
            href="/Marks"
            class="btn btn-secondary">

            Cancel

        </a>

    </div>

</form>