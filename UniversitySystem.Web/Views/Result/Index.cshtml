@using UniversitySystem.Application.DTOs
@model UniversitySystem.Application.DTOs.StudentResultDto

<h1 class="mb-4">🎓 Academic Transcript</h1>

<div class="mb-3">
    <h4>Student: <span class="text-primary">@Model.StudentName</span></h4>
    <h5>ID: <span class="text-muted">@Model.StudentIdCode</span></h5>
</div>

<div class="mb-3">
    <h4>
        GPA: <span class="text-success">@Model.GPA.ToString("0.00")</span>
    </h4>
    <h4>
        Final Grade: <span class="text-info">@Model.FinalGrade</span>
    </h4>
</div>

<table class="table table-hover table-bordered">
    <thead class="table-dark">
    <tr>
        <th>Course</th>
        <th>Marks</th>
        <th>Grade</th>
        <th>Grade Point</th>
        @if (User.IsInRole("Admin"))
        {
            <th>Actions</th>
        }
    </tr>
    </thead>
    <tbody>
    @foreach (var row in Model.Results)
    {
        <tr>
            <td>@(row.CourseTitle ?? "N/A")</td>
            <td>@row.Score</td>
            <td>@row.Grade</td>
            <td>@row.GradePoint.ToString("0.00")</td>
            @if (User.IsInRole("Admin"))
            {
                <td>
                    <a asp-action="Edit" asp-route-id="@row.Id" class="btn btn-sm btn-warning">
                        <i class="fa fa-edit"></i> Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@row.Id" class="btn btn-sm btn-danger">
                        <i class="fa fa-trash"></i> Delete
                    </a>
                </td>
            }
        </tr>
    }
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Search" class="btn btn-secondary">
        ⬅ Back
    </a>
    <a asp-action="Print" asp-route-studentId="@ViewBag.StudentId" class="btn btn-info">
        🖨 Print
    </a>
</div>