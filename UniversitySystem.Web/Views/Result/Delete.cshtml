@using UniversitySystem.Application.DTOs
@model UniversitySystem.Application.DTOs.StudentMarkDto

@{
    ViewData["Title"] = "Delete Student Marks";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4 text-danger">⚠️ Confirm Delete</h2>

<div class="alert alert-warning">
    <strong>Are you sure?</strong> You are about to delete the marks record for:
</div>

<div class="card shadow-sm p-4">
    <dl class="row">
        <dt class="col-sm-3">Student</dt>
        <dd class="col-sm-9">@Model.StudentName</dd>

        <dt class="col-sm-3">Course</dt>
        <dd class="col-sm-9">@Model.CourseTitle</dd>

        <dt class="col-sm-3">Marks</dt>
        <dd class="col-sm-9">@Model.Score</dd>

        <dt class="col-sm-3">Grade</dt>
        <dd class="col-sm-9">@Model.Grade</dd>

        <dt class="col-sm-3">Grade Point</dt>
        <dd class="col-sm-9">@Model.GradePoint.ToString("0.00")</dd>
    </dl>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="StudentId" />

    <button type="submit" class="btn btn-danger">
        <i class="fa fa-trash"></i> Delete
    </button>
    <a asp-action="Index" asp-route-studentId="@Model.StudentId" class="btn btn-secondary">
        <i class="fa fa-arrow-left"></i> Cancel
    </a>
</form>