@model List<UniversitySystem.Application.DTOs.StudentDto>

@{
    ViewData["Title"] = "Students";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between mb-4">

        <div>
            <h1>🎓 Student Dashboard</h1>
            <p>Manage students and results</p>
        </div>

        <div>

            <a
                href="/Student/Create"
                class="btn btn-success">

                + Add Student

            </a>

        </div>

    </div>

    <div class="row mb-4">

        <div class="col-md-6">

            <div class="card p-4">

                <h5>Total Students</h5>

                <h1>
                    @(ViewBag.TotalStudents ?? 0)
                </h1>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card p-4">

                <h5>Departments</h5>

                <h1>
                    @(ViewBag.TotalDepartments ?? 0)
                </h1>

            </div>

        </div>

    </div>

    <form method="get">

        <div class="input-group mb-4">

            <input
                name="search"
                value="@ViewBag.Search"
                class="form-control"
                placeholder="Search Student"
            />

            <button class="btn btn-primary">

                Search

            </button>

        </div>

    </form>

    <div class="card">

        <div class="card-body">

            <table class="table table-hover">

                <thead>

                <tr>

                    <th>ID</th>
                    <th>Student ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Department</th>
                    <th>Result</th>
                    <th>Action</th>

                </tr>

                </thead>

                <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach(var s in Model)
                    {
                        <tr>

                            <td>@s.Id</td>

                            <td>@s.StudentIdCode</td>

                            <td>@s.Name</td>

                            <td>@s.Email</td>

                            <td>@s.DepartmentName</td>

                            <td>

                                <a
                                    href="/Result/Student/@s.Id"
                                    class="btn btn-info">

                                    View Result

                                </a>

                            </td>

                            <td>

                                <a
                                    href="/Student/Edit/@s.Id"
                                    class="btn btn-warning">

                                    Edit

                                </a>

                                <a
                                    href="/Student/Delete/@s.Id"
                                    class="btn btn-danger">

                                    Delete

                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="7">

                            No Student Found

                            <br><br>

                            <a
                                href="/Student/Create"
                                class="btn btn-success">

                                Create First Student

                            </a>

                        </td>

                    </tr>
                }

                </tbody>

            </table>

        </div>

    </div>

    @if(ViewBag.TotalPages>1)
    {
        <div class="mt-4">

            @for(
                int i=1;
                i<=ViewBag.TotalPages;
                i++
            )
            {
                <a
                    class="btn btn-sm btn-outline-primary"
                    href="/Student?page=@i">

                    @i

                </a>
            }

        </div>
    }

</div>