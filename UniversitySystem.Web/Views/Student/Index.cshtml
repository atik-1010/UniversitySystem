@model List<UniversitySystem.Application.DTOs.StudentDto>

@{
    ViewData["Title"] = "Students";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

<style>

    body {
        background: #0b1220;
        color: white;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
    }

    .page-subtitle {
        color: #94a3b8;
        font-size: 14px;
    }

    .card-box {
        background: #111827;
        border-radius: 18px;
        padding: 20px;
        box-shadow: 0 10px 25px rgba(0,0,0,.3);
    }

    .student-badge {
        background: #1d4ed8;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
    }

    .table {
        color: white;
    }

    .table th {
        background: #1f2937;
        border: none;
        color: #fff;
    }

    .table td {
        border-color: #1f2937;
    }

    .btn-modern {
        border-radius: 10px;
    }

    .search-input {
        background: #0f172a;
        border: 1px solid #96aee6;
        color: white;
    }

    .search-input:focus {
        background: #fcfcfd;
        color: #1b1b37;
    }

    .stats {
        font-size: 30px;
        font-weight: 700;
        color: #38bdf8;
    }

</style>

<div class="container py-4">

    <!-- HEADER -->
    <div class="page-header">

        <div>
            <div class="page-title">
                👨‍🎓 Student Management
            </div>
            <div class="page-subtitle">
                Manage students, departments and academic records
            </div>
        </div>

        <a href="/Student/Create" class="btn btn-success btn-modern">
            <i class="fa fa-plus"></i> Create Student
        </a>

    </div>

    <!-- STATS -->
    <div class="card-box mb-3">

        <div class="row">

            <div class="col-md-6">
                <h6 class="text-secondary">Total Students</h6>
                <div class="stats">
                    @(Model?.Count ?? 0)
                </div>
            </div>

            <div class="col-md-6 text-end">
                <span class="badge bg-success fs-6">Active Records</span>
            </div>

        </div>

    </div>

    <!-- SEARCH -->
    <div class="card-box mb-3">

        <form method="get">
            <div class="row">

                <div class="col-md-10">
                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control search-input form-control-lg"
                           placeholder="Search by ID, Name, Email, Department..." />
                </div>

                <div class="col-md-2">
                    <button class="btn btn-primary btn-lg w-100 btn-modern">
                        <i class="fa fa-search"></i> Search
                    </button>
                </div>

            </div>
        </form>

    </div>

    <!-- TABLE -->
    <div class="card-box">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>
                <tr>
                    <th>ID</th>
                    <th>Student ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Department</th>
                    <th>Actions</th>
                </tr>
                </thead>

                <tbody>

                @if (Model != null && Model.Count > 0)
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>#@item.Id</td>

                            <td>
                                <span class="student-badge">
                                    @item.StudentIdCode
                                </span>
                            </td>

                            <td><b>@item.Name</b></td>

                            <td>@item.Email</td>

                            <td>@item.DepartmentName</td>

                            <td>

                                <a href="/Student/Edit/@item.Id"
                                   class="btn btn-warning btn-sm btn-modern">
                                    <i class="fa fa-edit"></i>
                                </a>

                                <button class="btn btn-danger btn-sm btn-modern"
                                        onclick="deleteStudent(@item.Id)">
                                    <i class="fa fa-trash"></i>
                                </button>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            No Student Records Found
                        </td>
                    </tr>
                }

                </tbody>

            </table>

        </div>

    </div>

    <!-- PAGINATION -->
    <div class="mt-4 text-center">

        @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
        {
            for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <a class="btn btn-sm @(i == ViewBag.CurrentPage ? "btn-primary" : "btn-outline-light") mx-1"
                   href="/Student?page=@i&search=@ViewBag.Search">
                    @i
                </a>
            }
        }

    </div>

</div>

<!-- SCRIPT FIXED -->
<script>
function deleteStudent(id) {
    if (!confirm("Delete this student?")) return;

    fetch('/Student/Delete?id=' + id, {
        method: 'GET'
    })
    .then(r => {
        if (r.ok) {
            location.reload();
        } else {
            alert("Failed to delete");
        }
    });
}
</script>