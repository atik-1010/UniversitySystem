@model UniversitySystem.Domain.Entities.Student

@{
ViewData["Title"] = "Create Student";
}

<style>

.form-container{
    max-width:900px;
    margin:auto;
}

.glass-card{
    background:white;
    border-radius:24px;
    padding:35px;
    box-shadow:0 15px 40px rgba(0,0,0,.08);
}

.page-title{
    font-size:30px;
    font-weight:700;
    color:#0f172a;
}

.page-subtitle{
    color:#64748b;
    margin-bottom:25px;
}

.form-label{
    font-weight:600;
    margin-bottom:8px;
}

.form-control,
.form-select{
    border-radius:12px;
    padding:12px;
    border:1px solid #dbe2ea;
}

.form-control:focus,
.form-select:focus{
    box-shadow:0 0 0 4px rgba(37,99,235,.15);
    border-color:#2563eb;
}

.info-box{
    background:#eff6ff;
    border-left:5px solid #2563eb;
    padding:15px;
    border-radius:12px;
    margin-bottom:25px;
}

.action-buttons{
    margin-top:30px;
}

</style>

<div class="form-container">


<div class="mb-4">

    <div class="page-title">
        👨‍🎓 Create Student
    </div>

    <div class="page-subtitle">
        Add a new student into the University Management System
    </div>

</div>

<div class="info-box">

    <strong>Total Departments:</strong>
    @ViewBag.TotalDepartment

</div>

<div class="glass-card">

    <form asp-controller="Student"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="alert alert-danger">
        </div>

        <div class="row">

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Student ID
                </label>

                <input asp-for="StudentIdCode"
                       class="form-control"
                       placeholder="Example: STU-001" />

                <span asp-validation-for="StudentIdCode"
                      class="text-danger">
                </span>

            </div>

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Full Name
                </label>

                <input asp-for="Name"
                       class="form-control"
                       placeholder="Enter Student Name" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>

            </div>

        </div>

        <div class="row">

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Email Address
                </label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="student@email.com" />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>

            <div class="col-md-6 mb-3">

                <label class="form-label">
                    Department
                </label>

                <select asp-for="DepartmentId"
                        asp-items="ViewBag.Departments"
                        class="form-select">

                    <option value="">
                        Select Department
                    </option>

                </select>

                <span asp-validation-for="DepartmentId"
                      class="text-danger">
                </span>

            </div>

        </div>

        <div class="action-buttons">

            <button type="submit"
                    class="btn btn-success btn-lg">

                <i class="fa fa-save"></i>
                Save Student

            </button>

            <a asp-action="Index"
               class="btn btn-secondary btn-lg">

                <i class="fa fa-arrow-left"></i>
                Back

            </a>

        </div>

    </form>

</div>


</div>

@section Scripts{


@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}


}
