@using UniversitySystem.Application.DTOs
@model IEnumerable<AlumniDto>

@{
    ViewData["Title"] = "All Alumni";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>All Alumni</h2>
<hr />

@if (Model != null && Model.Any())
{
    <table class="table table-bordered table-striped">
        <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Graduation Year</th>
            <th>Department</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var alumni in Model)
        {
            <tr>
                <td>@alumni.Name</td>
                <td>@alumni.Email</td>
                <td>@alumni.GraduationYear</td>
                <td>@alumni.DepartmentName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@alumni.Id" class="btn btn-primary btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@alumni.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info text-center">
        No alumni available.
    </div>
}