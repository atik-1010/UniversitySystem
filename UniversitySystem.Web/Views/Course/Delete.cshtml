@using UniversitySystem.Application.DTOs
@model CourseDto

@{
    ViewData["Title"] = "Delete Course";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Delete Course</h2>
<hr />

<div class="alert alert-danger">
    <strong>Are you sure you want to delete this course record?</strong>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <p><strong>Title:</strong> @Model.Title</p>
        <p><strong>Code:</strong> @Model.Code</p>
        <p><strong>Credit:</strong> @Model.Credit</p>
        <p><strong>Department:</strong> @Model.DepartmentName</p>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">
        <i class="fa fa-trash"></i> Confirm Delete
    </button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>