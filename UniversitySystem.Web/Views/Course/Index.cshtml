@using UniversitySystem.Application.DTOs
@model IEnumerable<CourseDto>

@{
    ViewData["Title"] = "All Courses";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>All Courses</h2>
<hr />

@if (Model != null && Model.Any())
{
    <table class="table table-bordered table-striped">
        <thead>
        <tr>
            <th>Title</th>
            <th>Code</th>
            <th>Credit</th>
            <th>Department</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@course.Title</td>
                <td>@course.Code</td>
                <td>@course.Credit</td>
                <td>@course.DepartmentName</td>
                <td>
                    <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-primary btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@course.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info text-center">
        No courses available.
    </div>
}