@model List<UniversitySystem.Application.DTOs.CourseDto>

@{
    ViewData["Title"] = "Courses";
}

<h2>Course List</h2>

<a href="/Course/Create" class="btn btn-success mb-3">+ Add Course</a>

<table class="table table-bordered table-striped">
    <thead>
    <tr>
        <th>Title</th>
        <th>Code</th>
        <th>Credit</th>
        <th>Department</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Code</td>
                <td>@item.Credit</td>
                <td>@item.DepartmentName</td>
                <td>
                    <a href="/Course/Edit/@item.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a href="/Course/Delete/@item.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="5" class="text-center">
                No courses found.<br />
                <a href="/Course/Create" class="btn btn-success mt-2">Create First Course</a>
            </td>
        </tr>
    }
    </tbody>
</table>