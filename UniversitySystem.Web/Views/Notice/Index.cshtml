@model IEnumerable<UniversitySystem.Application.DTOs.NoticeDto>

@{
    ViewData["Title"] = "Notice Board";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Notice Board</h2>
<hr />

<div class="card mt-4">
    <div class="card-header">
        <h4>All Notices</h4>
        <a asp-action="Create" class="btn btn-success btn-sm float-end">+ Add Notice</a>
    </div>
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <table class="table table-bordered table-striped">
                <thead>
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var notice in Model)
                {
                    <tr>
                        <td>@notice.Title</td>
                        <td>@notice.Description</td>
                        <td>@notice.Date.ToShortDateString()</td>
                        <td>
                            <a asp-action="Delete" asp-route-id="@notice.Id" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <p>No notices found.</p>
        }
    </div>
</div>