@model UniversitySystem.Application.DTOs.NoticeDto

@{
    ViewData["Title"] = "Delete Notice";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Delete Notice</h2>
<hr />

<div class="alert alert-danger">
    <strong>Are you sure you want to delete this notice?</strong>
</div>

<div class="card mt-3">
    <div class="card-body">
        <p><strong>Title:</strong> @Model.Title</p>
        <p><strong>Description:</strong> @Model.Description</p>
        <p><strong>Date:</strong> @Model.Date.ToShortDateString()</p>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>