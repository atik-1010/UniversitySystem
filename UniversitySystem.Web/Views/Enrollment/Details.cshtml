@using UniversitySystem.Application.DTOs
@model EnrollmentDto

@{
    ViewData["Title"] = "Enrollment Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Enrollment Details</h2>
<hr />

<div class="card shadow-sm">
    <div class="card-body">
        <h4 class="card-title">@Model.CourseTitle</h4>
        <p><strong>Student:</strong> @Model.StudentName</p>
        <p><strong>Department:</strong> @Model.DepartmentName</p>
        <p><strong>Enrollment Date:</strong> @Model.EnrolledOn.ToString("yyyy-MM-dd")</p>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fa fa-arrow-left"></i> Back to Enrollments
    </a>

    @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="fa fa-edit"></i> Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
            <i class="fa fa-trash"></i> Delete
        </a>
    }

    @if (User.IsInRole("Student"))
    {
        <a asp-action="UnEnroll" asp-route-id="@Model.Id" class="btn btn-danger">
            <i class="fa fa-times"></i> UnEnroll
        </a>
    }
</div>