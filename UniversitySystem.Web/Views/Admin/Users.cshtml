@model List<UniversitySystem.Domain.Entities.AppUser>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">

    <h2>👨‍💼 User Management</h2>

    <a href="/Account/Register" class="btn btn-success mb-3">Create User</a>

    <table class="table table-dark table-striped">
        <thead>
        <tr>
            <th>ID</th>
            <th>Username</th>
            <th>Full Name</th>
            <th>Role</th>
        </tr>
        </thead>

        <tbody>
        @foreach(var u in Model)
        {
            <tr>
                <td>@u.Id</td>
                <td>@u.Username</td>
                <td>@u.FullName</td>
                <td>@u.Role</td>
            </tr>
        }
        </tbody>
    </table>

</div>