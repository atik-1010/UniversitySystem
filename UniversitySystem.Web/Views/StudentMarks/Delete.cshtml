@using UniversitySystem.Domain.Entities
@model StudentMark

@{
    ViewData["Title"] = "Delete Student Mark";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Delete Student Mark</h2>
<hr />

<div class="alert alert-danger">
    <strong>Are you sure you want to delete this mark record?</strong>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <h4 class="card-title">@Model.Student?.Name</h4>
        <p><strong>Course:</strong> @Model.Course?.Title</p>
        <p><strong>Score:</strong> @Model.Score</p>
        <p><strong>Grade Point:</strong> @Model.GradePoint</p>
        <p><strong>Grade:</strong> @Model.Grade</p>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">
        <i class="fa fa-trash"></i> Confirm Delete
    </button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>